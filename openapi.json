{
  "openapi": "3.1.0",
  "info": {
    "title": "Sednicon API",
    "description": "Sednicon is a resilient, multi-provider icon resolution infrastructure that streams customizable SVG icons on the fly via a single URL. Features npm CDN resolution (jsDelivr, unpkg), specialized providers (Devicon, SVGL, Cryptocurrency Icons), Universal Iconify JSON extraction, two-tier caching (L1/L2), provider circuit breakers, and strict SVG security sanitization.",
    "version": "3.5.0",
    "contact": {
      "name": "Sednium",
      "url": "https://sednium.com"
    },
    "license": {
      "name": "MIT",
      "url": "https://github.com/AnkushDas4/SEDNICON/blob/main/README.md"
    }
  },
  "servers": [
    {
      "url": "https://sednicon.sednium.com",
      "description": "Production"
    }
  ],
  "tags": [
    { "name": "Icons", "description": "Render dynamic SVG icons across multiple upstreams" },
    { "name": "AI Generate", "description": "AI-powered SVG icon generation" },
    { "name": "Batch", "description": "Batch icon rendering (sprite/JSON)" },
    { "name": "Status", "description": "API health and multi-provider operational telemetry" }
  ],
  "paths": {
    "/api/render": {
      "get": {
        "tags": ["Icons"],
        "summary": "Render an icon as SVG",
        "description": "Returns an SVG image for the requested icon name, with optional color, size, animation, and style customization. Supports multi-provider resolution with graceful degradation.",
        "operationId": "renderIcon",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "description": "Icon name or prefix:name (e.g. `rocket`, `lucide:rocket`, `devicon:python`, `crypto:btc`, `svgl:react`).",
            "required": false,
            "schema": {
              "type": "string",
              "default": "circle"
            }
          },
          {
            "name": "color",
            "in": "query",
            "description": "Icon color as a hex code (with or without `#`) or a CSS color keyword.",
            "required": false,
            "schema": {
              "type": "string",
              "default": "000000"
            }
          },
          {
            "name": "size",
            "in": "query",
            "description": "Icon width and height in pixels (1–2048).",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 24,
              "minimum": 1,
              "maximum": 2048
            }
          },
          {
            "name": "anim",
            "in": "query",
            "description": "Optional animation style (`spin`, `pulse`, `bounce`).",
            "required": false,
            "schema": {
              "type": "string",
              "enum": ["spin", "pulse", "bounce"]
            }
          },
          {
            "name": "style",
            "in": "query",
            "description": "Icon style variant where supported (`outline`, `filled`, `solid`, `regular`, `duotone`, `color`, `black`, `original`, `plain`, `light`, `dark`).",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "set",
            "in": "query",
            "description": "Optional explicit icon set prefix to target (e.g. `lucide`, `tabler`, `devicon`, `svgl`, `crypto`).",
            "required": false,
            "schema": { "type": "string" }
          },
          {
            "name": "format",
            "in": "query",
            "description": "Output format (`svg`).",
            "required": false,
            "schema": { "type": "string", "enum": ["svg"], "default": "svg" }
          }
        ],
        "responses": {
          "200": {
            "description": "SVG icon styled with requested parameters.",
            "headers": {
              "Content-Type": { "schema": { "type": "string", "example": "image/svg+xml; charset=utf-8" } },
              "Cache-Control": { "schema": { "type": "string" } },
              "X-Sednicon-Source": { "schema": { "type": "string" } },
              "X-Sednicon-Provider": { "schema": { "type": "string" } },
              "X-Sednicon-Cache": { "schema": { "type": "string", "enum": ["HIT", "MISS"] } }
            },
            "content": {
              "image/svg+xml": { "schema": { "type": "string", "format": "binary" } }
            }
          },
          "429": { "description": "Rate limited" },
          "204": { "description": "CORS preflight" }
        }
      }
    },
    "/api/sprite": {
      "get": {
        "tags": ["Batch"],
        "summary": "Fetch multiple icons via GET query",
        "description": "Accepts a comma-separated list of icon names via query parameters and returns an SVG sprite sheet or JSON array.",
        "operationId": "getSpriteQuery",
        "parameters": [
          {
            "name": "icons",
            "in": "query",
            "required": true,
            "description": "Comma-separated icon names (e.g. `github,twitter,linkedin`).",
            "schema": { "type": "string" }
          },
          {
            "name": "color",
            "in": "query",
            "schema": { "type": "string", "default": "black" }
          },
          {
            "name": "size",
            "in": "query",
            "schema": { "type": "integer", "default": 24 }
          },
          {
            "name": "format",
            "in": "query",
            "schema": { "type": "string", "enum": ["symbol", "json"], "default": "symbol" }
          }
        ],
        "responses": {
          "200": { "description": "SVG sprite or JSON array" },
          "400": { "description": "Invalid query" },
          "429": { "description": "Rate limited" }
        }
      },
      "post": {
        "tags": ["Batch"],
        "summary": "Fetch multiple icons via JSON body",
        "description": "Accepts an array of icon objects and returns them as an SVG sprite sheet or JSON array.",
        "operationId": "postSpriteBody",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["icons"],
                "properties": {
                  "icons": {
                    "type": "array",
                    "maxItems": 50,
                    "items": {
                      "type": "object",
                      "properties": {
                        "q": { "type": "string" },
                        "color": { "type": "string" },
                        "size": { "type": "integer" },
                        "style": { "type": "string" }
                      }
                    }
                  },
                  "format": { "type": "string", "enum": ["symbol", "json"], "default": "symbol" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "SVG sprite or JSON array" },
          "429": { "description": "Rate limited" }
        }
      }
    },
    "/api/status": {
      "get": {
        "tags": ["Status"],
        "summary": "API health and multi-provider operational status",
        "operationId": "getStatus",
        "responses": {
          "200": { "description": "Service is operational" }
        }
      }
    },
    "/api/health/providers": {
      "get": {
        "tags": ["Status"],
        "summary": "Provider-level circuit breaker and telemetry health",
        "description": "Returns operational states, latency metrics, and circuit breaker status for all registered icon providers without exposing internal secrets.",
        "operationId": "getProvidersHealth",
        "responses": {
          "200": { "description": "Telemetry operational data" }
        }
      }
    },
    "/api/generate": {
      "post": {
        "tags": ["AI Generate"],
        "summary": "Generate an SVG icon using BYOK AI provider",
        "operationId": "generateIcon",
        "responses": {
          "200": { "description": "Generated SVG icon" }
        }
      }
    }
  }
}
